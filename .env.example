# Provider configuration
#
# Kev talks to OpenAI, Anthropic and Groq natively, or to any OpenAI-compatible
# endpoint. Which SDK is used comes from `provider` in ~/.kev/config.json (see
# README.md). With no config file Kev defaults to Groq, which reads the key from
# GROQ_API_KEY below.
GROQ_API_KEY=your-api-key-here

# Optional overrides, highest precedence over ~/.kev/config.json:
# KEV_PROVIDER=groq            # openai | anthropic | groq | openai-compatible
# KEV_PROVIDER_NAME=custom     # name for an openai-compatible endpoint
# KEV_BASE_URL=http://localhost:11434/v1
# KEV_MODEL=llama3.3:70b
# KEV_API_KEY_ENV=MY_KEY
# KEV_API_KEY=only-when-no-named-env-var-is-set
