# Provider configuration
#
# Kev talks to any OpenAI-compatible endpoint. The provider, base URL and model
# live in ~/.kev/config.json (see README.md) and default to Groq, which reads
# the key from the env var named by `apiKeyEnv` — GROQ_API_KEY below. Point it
# elsewhere (e.g. OPENROUTER_API_KEY) to use a different provider.
GROQ_API_KEY=your-api-key-here

# Optional overrides, highest precedence over ~/.kev/config.json:
# KEV_PROVIDER=custom
# KEV_BASE_URL=http://localhost:11434/v1
# KEV_MODEL=llama3.3:70b
# KEV_API_KEY_ENV=MY_KEY
# KEV_API_KEY=only-when-no-named-env-var-is-set
